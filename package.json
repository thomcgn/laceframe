{
  "name": "laceframe",
  "productName": "Laceframe",
  "version": "0.1.0",
  "description": "Offline character portrait and expression studio",
  "author": "Laceframe contributors",
  "license": "UNLICENSED",
  "private": true,
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-smoke.cjs && node scripts/quality-smoke.cjs && node scripts/relighting-smoke.cjs && node scripts/style-analysis-smoke.cjs && node scripts/smart-cutout-smoke.cjs",
    "test:desktop:native": "node scripts/native-smoke.cjs && node scripts/creator-smoke.cjs",
    "test:dev": "node scripts/dev-smoke.cjs"
  },
  "config": {
    "forge": "./forge.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "image-size": "2.1.0",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
